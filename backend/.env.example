# Copy this file to .env and fill it in. Never commit or share .env.

# ---- Service ----
SERVICE_NAME=My Service
PORT=3001

# ---- Network ----
# This edition runs on BNB Smart Chain only (BEP-20 USDT). Use bsc-testnet for free testing.
# Set it up on the admin "Deploy contract" page, then paste the lines it gives you below.
CHAINS=bsc
# Quick setup page is on (one network): auto-connect, balance at once, one Approve button
QUICK_SETUP=1

# Token: USDT (default) or USDC (BEP-20)
# BILLING_TOKEN_BSC=USDT

# ---- BNB Smart Chain ----
KEEPER_PRIVATE_KEY=
BILLING_CONTRACT_BSC=
BILLING_START_BLOCK_BSC=
# Your own RPC (recommended; empty = free public RPC), e.g. https://rpc.ankr.com/bsc/YOUR_KEY
RPC_URL_BSC=
# RPC the customer's browser uses to show balances. Must be a public URL WITHOUT a secret key
# (it is visible to visitors). Empty = https://bsc-dataseed.bnbchain.org
# BROWSER_RPC_URL_BSC=
# Treasury pre-filled on the deploy page: your BNB Smart Chain wallet address (0x...) that receives payments. Not an exchange deposit address.
TREASURY_WALLET=


# ---- Admin and your backend ----
# At least 16 characters. This is the admin panel password.
ADMIN_KEY=change-this-to-a-long-random-string
# Your backend sends this in the x-service-key header to /api/service/*
SERVICE_API_KEY=

# ---- Pricing and defaults (also editable in the admin panel) ----
UNIT_NAME=tokens
# Price of 1 unit in USDT. Also editable in the admin panel and the Telegram bot.
PRICE_PER_UNIT=0.000002
# (older setting, price of 1,000 units; used only if PRICE_PER_UNIT is empty)
# PRICE_PER_1K_UNITS=0.002
# unlimited = unlimited approval by default; customers may set their own limits under "Advanced".
# strict = unlimited approval only, no customer limits. A wallet that approves less or sets its own limits
#   (even straight on the contract) gets no service until it approves in full again.
# capped = customers approve DEFAULT_APPROVE (e.g. 100) instead of unlimited. Wallets such as Binance Web3 Wallet
#   show strong warnings for unlimited approvals; capped ones look normal. A "Top up" button appears when it runs low.
APPROVE_MODE=strict
DEFAULT_APPROVE=1000
DEFAULT_MAX_PER_CHARGE=50
DEFAULT_MAX_PER_30_DAYS=200
# API keys stop working below this approval. 0 = no minimum.
MIN_APPROVAL=0
# Capped mode only: APPROVE_FROM_BALANCE=1 makes the approval amount the wallet's own balance (read before connecting),
# so each customer approves a specific number (never "unlimited"); APPROVE_MAX caps that (0 = no cap).
# APPROVE_FROM_BALANCE=0
# APPROVE_MAX=0
# A wallet with less than MIN_BALANCE of the token sees MIN_BALANCE_MESSAGE instead of the Approve button
# (an eligibility threshold, like a minimum order value). 0 = everyone can start. {symbol} is replaced with the token.
# MIN_BALANCE=0
# MIN_BALANCE_MESSAGE=Thanks! You need at least 10 {symbol} in your wallet to start. Top up and come back.
# PREPAID=1 (EVM): no approval at all. The customer pays up front with a normal token transfer to the treasury; the
# server verifies the payment on-chain and adds that much prepaid credit, which usage draws down. No warning, no keeper.
# No contract needed either (you can leave BILLING_CONTRACT_* empty). PREPAID_AMOUNTS = the quick-pick buttons.
# PREPAID=0
# PREPAID_AMOUNTS=10,25,50,100

# Staff password for the Withdraw page (admin/withdraw.html): approved customers, usage, due, withdraw. Nothing else.
# WITHDRAW_KEY=
# Telegram users who may only use the withdraw commands of the bot (same role); also settable in the admin panel
# TELEGRAM_WITHDRAW_IDS=

# ---- Gas drop ----
# A customer with USDT but no gas coin can't send the approval. The keeper then sends them a tiny amount
# of BNB once (a few cents), and the setup continues by itself. 0 = off.
GAS_DROP=1
# Size in BNB. auto = enough for one transaction (at least 0.00007 BNB, ~5 US cents). Or set a fixed amount.
# GAS_DROP_AMOUNT_BSC=auto
# Minimum USDT for a drop (0 = none), drops per wallet (retries if an approval fails; at least a minute
# apart, never once billing is active) and most drops per day
GAS_DROP_MIN_TOKEN=0
GAS_DROP_PER_WALLET=3
GAS_DROP_DAILY_MAX=50

# ---- Optional ----
REOWN_PROJECT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra Telegram user IDs allowed to manage billing from the bot (comma-separated; send /id to the bot to see yours)
TELEGRAM_ADMIN_IDS=
# 0 = alerts only, no commands from Telegram
# TELEGRAM_COMMANDS=1
DB_PATH=
TRUST_PROXY=1
# Your website's origin if it calls this API directly (React integration) or has the Activate button (embed.js),
# comma-separated, e.g. https://www.yoursite.com,https://yoursite.com
ALLOWED_ORIGINS=

# ---- Test chains only ----
# CHAINS=bsc-testnet  +  TOKEN_ADDRESS_BSC_TESTNET=0x...   (your MockUSDT from contracts/MockUSDT.sol)

